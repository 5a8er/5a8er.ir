# Refuse to resolve a package version published in the last 7 days.
#
# Compromised-maintainer attacks on npm are typically caught within hours to a
# couple of days. A release-age floor converts that detection window into a
# window where this project is simply not exposed. It costs a week of latency
# on upgrades, which for a portfolio is free.
#
# CAVEAT: this key requires npm >= 11.10. The npm bundled with Node 20 is
# 10.8.2, which silently ignores unknown keys — so on a stock Node 20 machine
# this line does nothing. Until the local npm is upgraded, the real control is
# that every pinned version below was age-checked by hand against its publish
# date, and that package-lock.json is committed and installed with `npm ci`.
min-release-age=7

# Do not auto-install peer dependencies.
#
# Two concrete reasons, both load-bearing:
#
# 1. `@opennextjs/cloudflare` peer-depends on `rclone.js`, whose postinstall is
#    `node bin/rclone.js selfupdate` — it fetches a binary from outside the npm
#    registry. That hangs indefinitely on a restricted network, and we do not
#    use it: rclone only populates OpenNext's R2 incremental cache, and
#    `open-next.config.ts` enables no cache at all.
#
# 2. `@keystatic/core` peer-pins `react-aria@3.50.0` and `react-stately@3.48.0`
#    to exact versions, which conflicts with anything else in the tree that
#    wants a range.
#
# The cost is real: npm no longer warns about genuine peer mismatches. Version
# compatibility is instead asserted by `npm run typecheck` and by the Phase 1
# dual-target build, both of which run in CI.
legacy-peer-deps=true

# The registry is reachable from here but latency is high and unstable.
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

fund=false
