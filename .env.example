# Copy to `.env.local` for development. Never commit a filled-in copy.
# In production these live in Vercel project env vars and Cloudflare Worker
# secrets — both origins need the same values or the two will behave
# differently under failover.

# --- Site ---------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, OG image URLs,
# sitemap, RSS, and the security.txt Canonical field.
NEXT_PUBLIC_SITE_URL="https://5a8er.ir"

# Identifies which origin served a response. The router Worker echoes this as
# X-Served-By so failover is observable from outside.
ORIGIN_NAME="local"

# --- Contact: mail delivery (Resend) ------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender on the 5a8er.ir domain. Requires SPF + DKIM DNS records.
CONTACT_FROM_EMAIL="contact@5a8er.ir"
# Where submissions actually land.
CONTACT_TO_EMAIL=""

# --- Contact: abuse control ---------------------------------------------
# Cloudflare Turnstile. https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Upstash Redis holds the rate-limit counters. It must be shared: each origin
# has its own memory, so an in-process limiter would let an attacker get double
# the quota simply by hitting both. https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Keystatic admin (Vercel origin only) -------------------------------
# GitHub App credentials for the CMS. The callback URL is fixed to
# https://admin.5a8er.ir/api/keystatic/github/oauth/callback, which is why the
# admin is pinned to one origin.
#
# Until all three are set, keystatic.config.ts falls back to local (on-disk)
# storage so the project still builds. Set them only on the Vercel deployment;
# the Cloudflare build has no admin routes at all.
KEYSTATIC_GITHUB_CLIENT_ID=""
KEYSTATIC_GITHUB_CLIENT_SECRET=""
# "owner/name" of the repository Keystatic commits posts to.
KEYSTATIC_GITHUB_REPO=""
# Random 32+ byte string: `openssl rand -hex 32`
KEYSTATIC_SECRET=""
