{
  // The router Worker targets the Workers runtime, not the browser or Node, so
  // it cannot share the Next app's tsconfig. Runtime types are generated by
  // `npm run types:worker` (wrangler types) rather than pulled from
  // @cloudflare/workers-types — that keeps them locked to the exact workerd
  // build the vetted wrangler version ships, and adds no dependency whose
  // release age we would have to police.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
